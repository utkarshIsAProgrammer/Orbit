# ── ORBIT server environment template ─────────────────────────────────────
# Copy to .env (never commit .env — it's gitignored) and fill in real values.

# Core
NODE_ENV=development            # development | production | test
PORT=5006
TRUST_PROXY=1                   # 1 behind a reverse proxy (Render/Vercel) so req.ip is real

# Database — REQUIRED
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.nhxr6xt.mongodb.net/orbit?appName=Cluster0
JWT_SECRET=your_long_random_secret_here

# Redis cache (Upstash REST — optional, caching disabled if unset)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
# Alternative: native Redis (optional)
# REDIS_URL=redis://localhost:6379

# Media uploads — REQUIRED (Cloudinary)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional media CDN
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=

# ── Email ─────────────────────────────────────────────────────────────────
# Brevo (transactional email — free tier 300/day). When set, becomes the
# PRIMARY transport for ALL app emails. Get a key:
# https://app.brevo.com/settings/keys/api  (SMTP/API key, xkeysib-...)
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_FROM_EMAIL=inevitablestrangeutkarsh@gmail.com
BREVO_SENDER_NAME=ORBIT

# Fallback SMTP (used when BREVO_API_KEY is empty)
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_email_app_password

# ── URLs ──────────────────────────────────────────────────────────────────
# The deployed frontend origin — used for email CTAs, etc. The app is open
# to everyone: anyone may sign up, and waitlist members keep their Day One
# perks automatically (matched by canonical email at signup).
CLIENT_URL=https://your-frontend-domain.com
# Landing page (waitlist) origin — used in emails/links to the waitlist.
LANDING_PAGE_URL=https://your-landing-page-domain.com
# The deployed API origin (https://your-api.onrender.com). REQUIRED for the
# keep-alive scheduler (free hosts sleep without it) and for the waitlist
# opt-out links in confirmation emails.
PUBLIC_API_URL=https://your-api.onrender.com

# ── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# ⚠️ MUST point at the FRONTEND origin (Vercel), not the API origin — e.g.
# https://orbit.vercel.app/api/auth/google/callback. The browser starts the
# flow at the frontend URL, so the callback must also run through it for the
# JWT/CSRF cookies to be stored on the frontend's domain. If you point this
# at the API (onrender.com), the login redirects succeed but /api/auth/me
# returns 401 "No token" (cross-site cookies are never sent to the frontend).
GOOGLE_CALLBACK_URL=https://your-frontend-domain.com/api/auth/google/callback

# ── Web push (VAPID) — REQUIRED for device notifications ──────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@orbit.app

# ── LiveKit (calls) — optional; calling disabled without it ───────────────
# LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ── Observability (all optional) ──────────────────────────────────────────
# SENTRY_DSN=
# LOGTAIL_SOURCE_TOKEN=

# ── Search (optional) ─────────────────────────────────────────────────────
# MEILISEARCH_URL=
# MEILISEARCH_API_KEY=

# ── Waitlist anti-spam (all optional) ─────────────────────────────────────
# TURNSTILE_SECRET_KEY=            # Cloudflare Turnstile — REQUIRE a human check
# WAITLIST_SKIP_DNS=false          # true skips the real-MX DNS check (tests/offline)
# WAITLIST_EXTRA_BLOCKED_DOMAINS=  # extra disposable domains, comma-separated
