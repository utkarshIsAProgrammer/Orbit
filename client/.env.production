# Production build-time env for the Vercel deployment.
# The REST API is proxied by Vercel (/api -> Render), but Vercel cannot proxy
# WebSocket upgrades, so socket.io connects straight to the backend origin.
# Override anytime via the Vercel dashboard (VITE_SOCKET_URL takes precedence).
VITE_SOCKET_URL=https://orbit-5hkm.onrender.com
