# ── Language detection for GitHub ──────────
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript

# ── Mark directories as code ──────────────
client/src/** linguist-detectable
server/src/** linguist-detectable
landingpage/src/** linguist-detectable

# ── Exclude non-code from language stats ──
*.md linguist-documentation
*.json linguist-generated
roadmap/** linguist-documentation

# ── Auto-crlf ─────────────────────────────
* text=auto
